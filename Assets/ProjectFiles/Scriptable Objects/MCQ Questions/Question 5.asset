  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 5
  m_EditorClassIdentifier: 
  questionText: 5. The circular scale of a screw gauge contains 50 divisions and
    its pitch is 1 mm. What is the least count of the screw gauge?
  referenceImage: {fileID: 0}
  explanationText: 'Least count = Pitch / (Number of divisions on the circular scale)

    Least
    count = 1/50 mm

    Least count = 0.02 mm'
  options:
  - 0.02 mm
  - '0.2 mm '
  - '0.002 mm  '
  - 2 mm
  correctOptionIndex: 0
