  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 8
  m_EditorClassIdentifier: 
  questionText: 8. A wire's diameter is measured with a screw gauge. Main scale =
    4 mm, circular scale = 32 divisions, least count = 0.01 mm, and positive zero
    error = 0.02 mm. Find the correct diameter.
  referenceImage: {fileID: 0}
  explanationText: 'Correct reading = Main scale reading + coinciding division x
    least count - Zero error (with sign)

    Correct reading = 4+32x0.01-(0.02)

    Correct
    reading = 4.32 -0.02

    Correct reading = 4.30 mm'
  options:
  - '4.32 mm  '
  - '4.34 mm  '
  - 4.36 mm
  - 4.30 mm
  correctOptionIndex: 3
